+package org.dcache.space;
+
+import diskCacheV111.pools.PoolCostInfo;
+import diskCacheV111.pools.PoolCostInfo.PoolSpaceInfo;
+import diskCacheV111.services.space.Space;
+import java.util.Collection;
+import java.util.Locale;
+import java.util.Optional;
+import org.dcache.poolmanager.PoolMonitor;
+import org.springframework.remoting.RemoteAccessException;
+
+/**
+ * Total and free space of the storage, as reported by doors to clients (e.g., df on an NFS or
+ * xrootdfs mount).
+ */
+public final class Capacity {
+
+    /**
+     * Where doors take the reported capacity from, as configured by the
+     * {@code <door>.capacity.source} properties.
+     */
+    public enum Source {
+        /**
+         * No capacity information; doors report a fixed size, as the NFS door always did.
+         */
+        NAMESPACE,
+
+        /**
+         * The sum over all pools, as the frontend does for storage resource reporting.
+         */
+        POOLS,
+
+        /**
+         * A space reservation.
+         */
+        RESERVATION;
+
+        public static Source fromProperty(String value) {
+            try {
+                return valueOf(value.strip().toUpperCase(Locale.ROOT));
+            } catch (IllegalArgumentException e) {
+                throw new IllegalArgumentException("Invalid capacity source: " + value);
+            }
+        }
+    }
+
+    /**
+     * Size reported if the capacity is unknown. This is the same fixed size that Chimera reports
+     * for the namespace.
+     */
+    public static final long UNKNOWN_SIZE = 1L << 60;
+
+    /**
+     * Capacity reported if the capacity is unknown: a fixed size, all of which is free.
+     */
+    public static final Capacity UNKNOWN = new Capacity(UNKNOWN_SIZE, UNKNOWN_SIZE, null);
+
+    private final long totalSpace;
+    private final long freeSpace;
+    private final String reservation;
+
+    private Capacity(long totalSpace, long freeSpace, String reservation) {
+        this.totalSpace = totalSpace;
+        this.freeSpace = Math.min(Math.max(0L, freeSpace), totalSpace);
+        this.reservation = reservation;
+    }
+
+    /**
+     * Returns the capacity of a space reservation: its size and the space that is neither used nor
+     * allocated.
+     */
+    public static Capacity of(Space space) {
+        return new Capacity(space.getSizeInBytes(), space.getAvailableSpaceInBytes(),
+              String.valueOf(space.getId()));
+    }
+
+    /**
+     * Returns the capacity summed over all pools known to the pool monitor. Space taken by
+     * removable (cached) replicas is counted as free. Returns an empty value if no pool information
+     * is available.
+     */
+    public static Optional<Capacity> ofPools(PoolMonitor poolMonitor) {
+        Collection<PoolCostInfo> pools;
+        try {
+            pools = poolMonitor.getCostModule().getPoolCostInfos();
+        } catch (RemoteAccessException e) {
+            return Optional.empty();
+        }
+        if (pools.isEmpty()) {
+            return Optional.empty();
+        }
+
+        long total = 0;
+        long free = 0;
+        for (PoolCostInfo pool : pools) {
+            PoolSpaceInfo space = pool.getSpaceInfo();
+            total += space.getTotalSpace();
+            free += space.getFreeSpace() + space.getRemovableSpace();
+        }
+        return Optional.of(new Capacity(total, free, null));
+    }
+
+    /**
+     * Parses the value of a {@code <door>.capacity.reservation} property. Returns an empty value if
+     * no space reservation is configured.
+     *
+     * @throws IllegalArgumentException if the value is not a space token
+     */
+    public static Optional<String> parseReservation(String value) {
+        String token = value == null ? "" : value.strip();
+        if (token.isEmpty()) {
+            return Optional.empty();
+        }
+        try {
+            Long.parseLong(token);
+        } catch (NumberFormatException e) {
+            throw new IllegalArgumentException("Invalid space reservation: " + value);
+        }
+        return Optional.of(token);
+    }
+
+    public long getTotalSpace() {
+        return totalSpace;
+    }
+
+    public long getFreeSpace() {
+        return freeSpace;
+    }
+
+    public long getUsedSpace() {
+        return totalSpace - freeSpace;
+    }
+
+    /**
+     * Returns the token of the space reservation this capacity was taken from, if any.
+     */
+    public Optional<String> getReservation() {
+        return Optional.ofNullable(reservation);
+    }
+
+    @Override
+    public String toString() {
+        return "Capacity[total=" + totalSpace + ", free=" + freeSpace
+              + (reservation == null ? "" : ", reservation=" + reservation) + "]";
+    }
+}
diff --git a/modules/dcache/src/test/java/org/dcache/space/CapacityTest.java b/modules/dcache/src/test/java/org/dcache/space/CapacityTest.java
new file mode 100644
index 0000000..411d8ec
--- /dev/null
+++ b/modules/dcache/src/test/java/org/dcache/space/CapacityTest.java
@@ -0,0 +1,126 @@
+package org.dcache.space;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.junit.Assert.assertThrows;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import diskCacheV111.poolManager.CostModule;
+import diskCacheV111.pools.PoolCostInfo;
+import diskCacheV111.services.space.Space;
+import diskCacheV111.services.space.SpaceState;
+import diskCacheV111.util.AccessLatency;
+import diskCacheV111.util.RetentionPolicy;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Optional;
+import org.dcache.poolmanager.PoolMonitor;
+import org.junit.Test;
+import org.springframework.remoting.RemoteConnectFailureException;
+
+public class CapacityTest {
+
+    @Test
+    public void shouldParseCapacitySource() {
+        assertThat(Capacity.Source.fromProperty("namespace"), is(Capacity.Source.NAMESPACE));
+        assertThat(Capacity.Source.fromProperty("pools"), is(Capacity.Source.POOLS));
+        assertThat(Capacity.Source.fromProperty(" reservation "),
+              is(Capacity.Source.RESERVATION));
+    }
+
+    @Test
+    public void shouldRejectUnknownCapacitySource() {
+        assertThrows(IllegalArgumentException.class,
+              () -> Capacity.Source.fromProperty("1234"));
+    }
+
+    @Test
+    public void shouldParseReservation() {
+        assertThat(Capacity.parseReservation(" 42 "), is(Optional.of("42")));
+    }
+
+    @Test
+    public void shouldTreatEmptyReservationAsUnset() {
+        assertThat(Capacity.parseReservation(""), is(Optional.empty()));
+        assertThat(Capacity.parseReservation(null), is(Optional.empty()));
+    }
+
+    @Test
+    public void shouldRejectNonNumericReservation() {
+        assertThrows(IllegalArgumentException.class, () -> Capacity.parseReservation("CMS_DISK"));
+    }
+
+    @Test
+    public void shouldReportSizeAndAvailableSpaceOfReservation() {
+        Capacity capacity = Capacity.of(space(1000, 300, 200));
+
+        assertThat(capacity.getTotalSpace(), is(1000L));
+        assertThat(capacity.getFreeSpace(), is(500L));
+        assertThat(capacity.getUsedSpace(), is(500L));
+        assertThat(capacity.getReservation(), is(Optional.of("42")));
+    }
+
+    @Test
+    public void shouldNotReportNegativeFreeSpace() {
+        Capacity capacity = Capacity.of(space(100, 80, 50));
+
+        assertThat(capacity.getFreeSpace(), is(0L));
+        assertThat(capacity.getUsedSpace(), is(100L));
+    }
+
+    @Test
+    public void shouldSumSpaceOfAllPools() {
+        PoolMonitor poolMonitor = poolMonitor(
+              pool("pool1", 1000, 100, 50),
+              pool("pool2", 2000, 300, 0));
+
+        Capacity capacity = Capacity.ofPools(poolMonitor).orElseThrow();
+
+        assertThat(capacity.getTotalSpace(), is(3000L));
+        assertThat(capacity.getFreeSpace(), is(450L));
+        assertThat(capacity.getUsedSpace(), is(2550L));
+        assertThat(capacity.getReservation(), is(Optional.empty()));
+    }
+
+    @Test
+    public void shouldReportNothingWithoutPools() {
+        assertThat(Capacity.ofPools(poolMonitor()), is(Optional.empty()));
+    }
+
+    @Test
+    public void shouldReportNothingIfPoolInformationIsNotAvailable() {
+        PoolMonitor poolMonitor = mock(PoolMonitor.class);
+        when(poolMonitor.getCostModule()).thenThrow(
+              new RemoteConnectFailureException("Cached pool information is not yet available.",
+                    null));
+
+        assertThat(Capacity.ofPools(poolMonitor), is(Optional.empty()));
+    }
+
+    @Test
+    public void shouldReportUnknownCapacityAsFree() {
+        assertThat(Capacity.UNKNOWN.getTotalSpace(), is(1L << 60));
+        assertThat(Capacity.UNKNOWN.getUsedSpace(), is(0L));
+    }
+
+    private static PoolMonitor poolMonitor(PoolCostInfo... pools) {
+        List<PoolCostInfo> list = Arrays.asList(pools);
+        CostModule costModule = mock(CostModule.class);
+        when(costModule.getPoolCostInfos()).thenReturn(list);
+        PoolMonitor poolMonitor = mock(PoolMonitor.class);
+        when(poolMonitor.getCostModule()).thenReturn(costModule);
+        return poolMonitor;
+    }
+
+    private static PoolCostInfo pool(String name, long total, long free, long removable) {
+        PoolCostInfo info = new PoolCostInfo(name, "regular");
+        info.setSpaceUsage(total, free, 0, removable);
+        return info;
+    }
+
+    private static Space space(long size, long used, long allocated) {
+        return new Space(42, null, null, RetentionPolicy.REPLICA, AccessLatency.ONLINE, 1, size,
+              0, null, "test", SpaceState.RESERVED, used, allocated);
+    }
+}
diff --git a/skel/share/defaults/dcache.properties b/skel/share/defaults/dcache.properties
index 44fa2b2..e35b3a9 100644
--- a/skel/share/defaults/dcache.properties
+++ b/skel/share/defaults/dcache.properties
@@ -1012,6 +1012,41 @@ dcache.authn.ciphers = DISABLE_RFC_7540_BANNED_CIPHERS, ENABLE_WEAK_CIPHERS_FOR_
 #
 (one-of?true|false)dcache.enable.space-reservation=true
 
+#  ---- Storage capacity reported to clients
+#
+#   Doors that report the size and free space of the storage to clients
+#   (e.g., to df on an NFS or xrootdfs mount) take these values from one
+#   of the following sources:
+#
+#     namespace    No capacity information: a fixed size of 1 EiB is
+#                  reported. The NFS door reports the space used by all
+#                  files in the namespace as used space; the xrootd door
+#                  reports all space as free.
+#
+#     pools        The total and free space summed over all pools that
+#                  are currently online. Space taken by removable
+#                  (cached) replicas is counted as free. Note that
+#                  files on tape are not included, so on tape-backed
+#                  instances the reported used space may be much smaller
+#                  than the size of all files.
+#
+#     reservation  The size of a space reservation and the space still
+#                  available in it, i.e., neither used nor allocated.
+#                  The reservation is given by dcache.capacity.reservation
+#                  or, if that is empty, by the WriteToken directory tag
+#                  of the queried path. Requires a spacemanager service.
+#
+(one-of?namespace|pools|reservation)dcache.capacity.source = namespace
+
+#  ---- Space reservation reported to clients
+#
+#   The space token of the reservation reported if the capacity source
+#   is 'reservation'. If empty, doors that know the path of a query
+#   (e.g., xrootd) use the WriteToken directory tag of that path. Doors
+#   that don't (e.g., NFS) require a space token.
+#
+dcache.capacity.reservation =
+
 #  ---- Upload directory
 #
 #   Some protocols (currently just SRM) allow a client to upload a file and, once
-- 
