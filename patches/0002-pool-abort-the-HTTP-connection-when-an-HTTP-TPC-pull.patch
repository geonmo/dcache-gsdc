+package org.dcache.pool.movers;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.equalTo;
+import static org.hamcrest.Matchers.lessThan;
+import static org.junit.Assert.fail;
+import static org.mockito.BDDMockito.given;
+import static org.mockito.Mockito.mock;
+
+import com.sun.net.httpserver.HttpServer;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.nio.channels.ClosedByInterruptException;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import org.apache.http.HttpEntity;
+import org.apache.http.client.methods.CloseableHttpResponse;
+import org.apache.http.client.methods.HttpGet;
+import org.apache.http.conn.ConnectionReleaseTrigger;
+import org.apache.http.impl.client.CloseableHttpClient;
+import org.apache.http.impl.client.HttpClients;
+import org.apache.http.impl.conn.PoolingHttpClientConnectionManager;
+import org.junit.Test;
+
+public class RemoteHttpDataTransferProtocolTest {
+
+    private static final int BODY_SIZE = 1_000_000;
+
+    /**
+     * A response body of {@link #BODY_SIZE} bytes that records how much of it was read and whether
+     * it was closed or its connection aborted.
+     */
+    private static class Body extends InputStream implements ConnectionReleaseTrigger {
+
+        private int read;
+        private boolean closed;
+        private boolean aborted;
+
+        @Override
+        public int read() {
+            if (read == BODY_SIZE) {
+                return -1;
+            }
+            read++;
+            return 0;
+        }
+
+        @Override
+        public int read(byte[] b, int off, int len) throws IOException {
+            if (read == BODY_SIZE) {
+                return -1;
+            }
+            int n = Math.min(len, BODY_SIZE - read);
+            Arrays.fill(b, off, off + n, (byte) 0);
+            read += n;
+            return n;
+        }
+
+        @Override
+        public void close() {
+            closed = true;
+        }
+
+        @Override
+        public void releaseConnection() {
+        }
+
+        @Override
+        public void abortConnection() {
+            aborted = true;
+        }
+    }
+
+    private static final OutputStream FAILING_OUTPUT = new OutputStream() {
+        @Override
+        public void write(int b) throws IOException {
+            throw new ClosedByInterruptException();
+        }
+
+        @Override
+        public void write(byte[] b, int off, int len) throws IOException {
+            throw new ClosedByInterruptException();
+        }
+    };
+
+    private static HttpEntity entityWith(InputStream content) throws IOException {
+        HttpEntity entity = mock(HttpEntity.class);
+        given(entity.getContent()).willReturn(content);
+        return entity;
+    }
+
+    @Test
+    public void shouldCopyWholeBody() throws Exception {
+        byte[] data = new byte[BODY_SIZE];
+        data[BODY_SIZE - 1] = 42;
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+
+        RemoteHttpDataTransferProtocol.receiveBody(entityWith(new ByteArrayInputStream(data)), out);
+
+        assertThat(out.toByteArray(), equalTo(data));
+    }
+
+    @Test
+    public void shouldAbortConnectionWithoutDrainingBodyWhenWriteFails() throws Exception {
+        Body body = new Body();
+
+        try {
+            RemoteHttpDataTransferProtocol.receiveBody(entityWith(body), FAILING_OUTPUT);
+            fail("expected failure");
+        } catch (ClosedByInterruptException expected) {
+        }
+
+        assertThat(body.aborted, equalTo(true));
+        assertThat(body.closed, equalTo(false));
+        assertThat(body.read, lessThan(BODY_SIZE));
+    }
+
+    @Test
+    public void shouldAbortConnectionWithoutClosingBodyWhenReadFails() throws Exception {
+        Body body = new Body() {
+            @Override
+            public int read(byte[] b, int off, int len) throws IOException {
+                throw new IOException("connection reset");
+            }
+        };
+
+        try {
+            RemoteHttpDataTransferProtocol.receiveBody(entityWith(body),
+                  new ByteArrayOutputStream());
+            fail("expected failure");
+        } catch (IOException expected) {
+        }
+
+        assertThat(body.aborted, equalTo(true));
+        assertThat(body.closed, equalTo(false));
+    }
+
+    @Test
+    public void shouldShutDownHttpConnectionWhenWriteFails() throws Exception {
+        byte[] start = "some file content".getBytes(StandardCharsets.UTF_8);
+        CountDownLatch release = new CountDownLatch(1);
+        HttpServer server = HttpServer.create(
+              new InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0);
+        server.createContext("/large", e -> {
+            try {
+                e.sendResponseHeaders(200, BODY_SIZE);
+                e.getResponseBody().write(start);
+                e.getResponseBody().flush();
+                release.await(30, TimeUnit.SECONDS);
+            } catch (InterruptedException ignored) {
+            } finally {
+                e.close();
+            }
+        });
+        server.start();
+        PoolingHttpClientConnectionManager manager = new PoolingHttpClientConnectionManager();
+
+        try (CloseableHttpClient client = HttpClients.custom()
+              .setConnectionManager(manager).build();
+              CloseableHttpResponse response = client.execute(new HttpGet(
+                    "http://127.0.0.1:" + server.getAddress().getPort() + "/large"))) {
+            try {
+                RemoteHttpDataTransferProtocol.receiveBody(response.getEntity(), FAILING_OUTPUT);
+                fail("expected failure");
+            } catch (ClosedByInterruptException expected) {
+            }
+
+            // The connection is neither leased (being read) nor kept for reuse.
+            assertThat(manager.getTotalStats().getLeased(), equalTo(0));
+            assertThat(manager.getTotalStats().getAvailable(), equalTo(0));
+        } finally {
+            release.countDown();
+            server.stop(0);
+        }
+    }
+}
