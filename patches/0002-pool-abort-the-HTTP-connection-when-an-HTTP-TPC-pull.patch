                       && response.getStatusLine().getStatusCode() < 300 && length > -1) {
                     _expectedTransferSize = length;
                 }
-                entity.writeTo(Channels.newOutputStream(_channel));
+                receiveBody(entity, Channels.newOutputStream(_channel));
             } catch (SocketTimeoutException e) {
                 String message = "socket timeout on GET (received "
                       + describeSize(_channel.getBytesTransferred()) + " of data; "
@@ -448,6 +452,29 @@ public class RemoteHttpDataTransferProtocol implements MoverProtocol,
         }
     }
 
+    /**
+     * Copy the response body.  Unlike {@link HttpEntity#writeTo}, the content stream is not closed
+     * if the copy fails (e.g., because the mover was cancelled): closing it would read the rest of
+     * the body.  Instead, the connection is shut down, so that it is neither read to the end nor
+     * reused.
+     */
+    @VisibleForTesting
+    static void receiveBody(HttpEntity entity, OutputStream out) throws IOException {
+        InputStream in = entity.getContent();
+        try {
+            in.transferTo(out);
+        } catch (IOException | RuntimeException e) {
+            if (in instanceof ConnectionReleaseTrigger) {
+                try {
+                    ((ConnectionReleaseTrigger) in).abortConnection();
+                } catch (IOException suppressed) {
+                    e.addSuppressed(suppressed);
+                }
+            }
+            throw e;
+        }
+    }
+
