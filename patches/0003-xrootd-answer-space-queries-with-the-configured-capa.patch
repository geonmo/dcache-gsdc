+    /**
+     * Returns the capacity reported for the given path, as configured by xrootd.capacity.source.
+     * The path must exist and be accessible by the user. With 'reservation' and no configured space
+     * token, the space reservation is the one the path is associated with through the WriteToken
+     * directory tag.
+     */
+    public Capacity getCapacity(FsPath fullPath, Subject subject, Restriction restriction)
+          throws CacheException {
+        boolean useWriteToken = _capacitySource == Capacity.Source.RESERVATION
+              && _capacityReservation.isEmpty();
+        PnfsHandler pnfsHandler = new PnfsHandler(_pnfs, subject, restriction);
+        FileAttributes attributes = pnfsHandler.getFileAttributes(fullPath.toString(),
+              useWriteToken ? EnumSet.of(STORAGEINFO) : EnumSet.of(TYPE));
+
+        switch (_capacitySource) {
+            case NAMESPACE:
+                return Capacity.UNKNOWN;
+            case POOLS:
+                return Capacity.ofPools(_poolMonitor).orElseThrow(
+                      () -> new CacheException(CacheException.SERVICE_UNAVAILABLE,
+                            "Pool information is not available"));
+            case RESERVATION:
+                String token = useWriteToken
+                      ? attributes.getStorageInfo().getMap().get("writeToken")
+                      : _capacityReservation.get();
+                if (token == null) {
+                    throw new CacheException(CacheException.INVALID_ARGS,
+                          fullPath + " is not under space management");
+                }
+                return lookUpSpace(token);
+            default:
+                throw new IllegalStateException("Unexpected capacity source: " + _capacitySource);
+        }
+    }
+
+    private Capacity lookUpSpace(String token) throws CacheException {
+        try {
+            return _spaceLookupCache.get(token).map(Capacity::of).orElseThrow(
+                  () -> new CacheException("Space reservation " + token + " not found"));
+        } catch (ExecutionException e) {
+            Throwable cause = e.getCause();
+            Throwables.throwIfInstanceOf(cause, CacheException.class);
+            Throwables.throwIfUnchecked(cause);
+            throw new CacheException("Failed to look up space reservation " + token + ": "
+                  + cause.getMessage(), cause);
+        }
+    }
