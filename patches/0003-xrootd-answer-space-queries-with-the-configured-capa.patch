+/**
+ * Unit tests for {@link XrootdDoor#getCapacity} and {@link XrootdRedirectHandler#toSpaceInfo},
+ * which back kXR_Qspace queries.
+ */
+public class XrootdDoorSpaceQueryTest {
+
+    private static final FsPath PATH = FsPath.create("/data/cms");
+
+    private CellStub pnfsCellStub;
+    private XrootdDoor door;
+    private Subject subject;
+
+    @Before
+    public void setUp() {
+        pnfsCellStub = mock(CellStub.class);
+
+        door = new XrootdDoor();
+        door.setPnfsHandler(new PnfsHandler(pnfsCellStub));
+
+        subject = Subjects.of(1000, 1000, new int[]{1000});
+    }
+
+    @Test
+    public void shouldReportUnknownCapacityByDefault() throws Exception {
+        givenWriteToken(null);
+
+        Capacity capacity = door.getCapacity(PATH, subject, Restrictions.none());
+
+        assertThat(capacity.getTotalSpace(), is(1L << 60));
+        assertThat(capacity.getUsedSpace(), is(0L));
+    }
+
+    @Test
+    public void shouldReportSpaceOfAllPools() throws Exception {
+        givenWriteToken(null);
+        givenPools(pool("pool1", 1000, 100, 50), pool("pool2", 2000, 300, 0));
+        door.setCapacitySource("pools");
+
+        Capacity capacity = door.getCapacity(PATH, subject, Restrictions.none());
+
+        assertThat(capacity.getTotalSpace(), is(3000L));
+        assertThat(capacity.getFreeSpace(), is(450L));
+    }
+
+    @Test
+    public void shouldFailIfPoolInformationIsNotAvailable() {
+        givenWriteToken(null);
+        givenPools();
+        door.setCapacitySource("pools");
+
+        CacheException e = assertThrows(CacheException.class,
+              () -> door.getCapacity(PATH, subject, Restrictions.none()));
+        assertThat(e.getRc(), is(CacheException.SERVICE_UNAVAILABLE));
+    }
+
+    @Test
+    public void shouldReturnSpaceOfWriteToken() throws Exception {
+        givenWriteToken("42");
+        givenSpaceLookup(token -> token.equals("42")
+              ? Optional.of(space(1000, 300, 200)) : Optional.empty());
+        door.setCapacitySource("reservation");
+
+        Capacity capacity = door.getCapacity(PATH, subject, Restrictions.none());
+
+        assertThat(capacity.getTotalSpace(), is(1000L));
+        assertThat(capacity.getFreeSpace(), is(500L));
+        assertThat(capacity.getReservation(), is(Optional.of("42")));
+    }
+
+    @Test
+    public void shouldPreferConfiguredReservationOverWriteToken() throws Exception {
+        givenWriteToken("7");
+        givenSpaceLookup(token -> token.equals("42")
+              ? Optional.of(space(1000, 300, 200)) : Optional.empty());
+        door.setCapacitySource("reservation");
+        door.setCapacityReservation("42");
+
+        Capacity capacity = door.getCapacity(PATH, subject, Restrictions.none());
+
+        assertThat(capacity.getReservation(), is(Optional.of("42")));
+    }
+
+    @Test
+    public void shouldFailWithoutWriteToken() {
+        givenWriteToken(null);
+        givenSpaceLookup(token -> Optional.empty());
+        door.setCapacitySource("reservation");
+
+        CacheException e = assertThrows(CacheException.class,
