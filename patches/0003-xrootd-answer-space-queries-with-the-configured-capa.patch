+    /**
+     * Reports the capacity of the queried path, as configured by xrootd.capacity.source, in the
+     * format used by xrootd's oss plugin.
+     */
+    private QueryResponse querySpace(QueryRequest msg) throws XrootdException {
+        String args = msg.getArgs();
+        int pos = args.indexOf(XrootdProtocol.OPAQUE_DELIMITER);
+        String path = pos > -1 ? args.substring(0, pos) : args;
+        String opaque = pos > -1 ? args.substring(pos + 1) : "";
+        if (path.isEmpty()) {
+            throw new XrootdException(kXR_ArgMissing, "no path specified");
+        }
+
+        try {
+            LoginSessionInfo loginSessionInfo = sessionInfo();
+            Capacity capacity = _door.getCapacity(
+                  createFullPath(path, safelyExtractOpaque(opaque)),
+                  loginSessionInfo.getSubject(),
+                  loginSessionInfo.getRestriction());
+            return new QueryResponse(msg, toSpaceInfo(capacity));
+        } catch (CacheException e) {
+            throw xrootdException(e);
+        }
+    }
+
+    /**
+     * Formats the capacity like xrootd's oss plugin. The space group is the space token of a
+     * reservation, or "public", xrootd's default space name, otherwise.
+     */
+    static String toSpaceInfo(Capacity capacity) {
+        long total = capacity.getTotalSpace();
+        long free = capacity.getFreeSpace();
+        return "oss.cgroup=" + capacity.getReservation().orElse("public")
+              + "&oss.space=" + total
+              + "&oss.free=" + free
+              + "&oss.maxf=" + free
+              + "&oss.used=" + capacity.getUsedSpace()
+              + "&oss.quota=" + total;
+    }
+
