+# Only used if xrootd.capacity.source is 'reservation'.
+xrootd.service.spacemanager=${dcache.service.spacemanager}
+xrootd.service.spacemanager.timeout=30000
+(one-of?MILLISECONDS|SECONDS|MINUTES|HOURS|DAYS)xrootd.service.spacemanager.timeout.unit=MILLISECONDS
+
 # Cell address of poolmanager service
 xrootd.service.poolmanager=${xrootd.service.poolmanager-space-${xrootd.enable.space-reservation}}
 (immutable)xrootd.service.poolmanager-space-false=${dcache.service.poolmanager}
