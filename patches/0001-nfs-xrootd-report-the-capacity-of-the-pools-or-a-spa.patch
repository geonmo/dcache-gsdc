+
+/**
+ * Total and free space reported by doors to clients (e.g., to df on an NFS or xrootdfs mount),
+ * as configured by the {@code <door>.capacity.source} and {@code <door>.capacity.reservation}
+ * properties.
+ */
+public final class Capacity {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(Capacity.class);
+
+    /**
+     * Reported if the capacity is unknown: the same fixed size that Chimera reports, all free.
+     */
+    public static final Capacity UNKNOWN = new Capacity(1L << 60, 1L << 60, null);
+
+    public enum Source {NAMESPACE, POOLS, RESERVATION}
+
+    private final long total;
+    private final long free;
+    private final String reservation;
+
+    private Capacity(long total, long free, String reservation) {
+        this.total = total;
+        this.free = Math.min(Math.max(0L, free), total);
+        this.reservation = reservation;
+    }
+
+    public long getTotalSpace() {
+        return total;
+    }
+
+    public long getFreeSpace() {
+        return free;
+    }
+
+    public long getUsedSpace() {
+        return total - free;
+    }
+
+    /**
+     * Returns the token of the space reservation this capacity was taken from, if any.
+     */
+    public Optional<String> getReservation() {
+        return Optional.ofNullable(reservation);
+    }
+
+    /**
+     * Determines the capacity a door reports.
+     */
+    public static class Provider {
+
+        private final Source source;
+        private final String reservation;
+        private final PoolMonitor poolMonitor;
+        private final LoadingCache<String, Optional<Space>> spaceLookupCache;
+        private final Set<String> failing = ConcurrentHashMap.newKeySet();
+
+        public Provider(String source, String reservation, PoolMonitor poolMonitor,
+              LoadingCache<String, Optional<Space>> spaceLookupCache) {
+            try {
+                this.source = Source.valueOf(source.strip().toUpperCase(Locale.ROOT));
+            } catch (IllegalArgumentException e) {
+                throw new IllegalArgumentException("Invalid capacity source: " + source);
+            }
+            this.reservation = reservation.isBlank() ? null : reservation.strip();
+            if (this.reservation != null && !this.reservation.matches("\\d+")) {
+                throw new IllegalArgumentException("Invalid space reservation: " + reservation);
+            }
+            this.poolMonitor = poolMonitor;
+            this.spaceLookupCache = spaceLookupCache;
+        }
+
+        public Source getSource() {
+            return source;
+        }
+
+        /**
+         * Whether the space reservation is given by the WriteToken tag of the queried path.
+         */
+        public boolean usesWriteToken() {
+            return source == Source.RESERVATION && reservation == null;
+        }
+
+        /**
+         * Returns the capacity to report. A failure is logged once, rather than for every query,
+         * until the capacity can be determined again.
+         *
+         * @param writeToken the WriteToken tag of the queried path, if {@link #usesWriteToken()}
+         */
+        public Capacity get(String writeToken) throws CacheException {
+            if (source == Source.NAMESPACE) {
+                return UNKNOWN;
+            }
+            String token = reservation != null ? reservation : writeToken;
+            if (source == Source.RESERVATION && token == null) {
+                throw new CacheException(CacheException.INVALID_ARGS,
+                      "Path is not under space management");
+            }
+            String what = source == Source.POOLS ? "pools" : "space reservation " + token;
+            try {
+                Capacity capacity = source == Source.POOLS ? ofPools() : ofReservation(token);
+                if (failing.remove(what)) {
+                    LOGGER.info("Capacity of {} can be determined again.", what);
+                }
+                return capacity;
+            } catch (CacheException e) {
+                if (failing.add(what)) {
+                    LOGGER.warn("{}; capacity queries fail until it can be determined.",
+                          e.getMessage());
+                }
+                throw e;
+            }
+        }
+
+        private Capacity ofReservation(String token) throws CacheException {
+            try {
+                Space space = spaceLookupCache.get(token).orElseThrow(
+                      () -> new CacheException("Space reservation " + token + " not found"));
+                return new Capacity(space.getSizeInBytes(), space.getAvailableSpaceInBytes(),
+                      token);
+            } catch (ExecutionException e) {
+                throw new CacheException("Failed to look up space reservation " + token + ": "
+                      + e.getCause().getMessage(), e.getCause());
+            }
+        }
+
+        /**
+         * Sums the space of all online pools, counting removable (cached) replicas as free, as
+         * the frontend does for storage resource reporting.
+         */
+        private Capacity ofPools() throws CacheException {
+            List<PoolSpaceInfo> pools;
+            try {
+                pools = poolMonitor.getCostModule().getPoolCostInfos().stream()
+                      .map(PoolCostInfo::getSpaceInfo).collect(Collectors.toList());
+            } catch (RemoteAccessException e) {
+                pools = List.of();
+            }
+            if (pools.isEmpty()) {
+                throw new CacheException(CacheException.SERVICE_UNAVAILABLE,
+                      "Pool information is not available");
+            }
+            return new Capacity(pools.stream().mapToLong(PoolSpaceInfo::getTotalSpace).sum(),
+                  pools.stream().mapToLong(p -> p.getFreeSpace() + p.getRemovableSpace()).sum(),
+                  null);
+        }
+    }
+}
diff --git a/modules/dcache/src/test/java/org/dcache/space/CapacityTest.java b/modules/dcache/src/test/java/org/dcache/space/CapacityTest.java
new file mode 100644
index 0000000..c3ace45
--- /dev/null
+++ b/modules/dcache/src/test/java/org/dcache/space/CapacityTest.java
@@ -0,0 +1,122 @@
+package org.dcache.space;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.junit.Assert.assertThrows;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import com.google.common.cache.CacheBuilder;
+import com.google.common.cache.CacheLoader;
+import diskCacheV111.poolManager.CostModule;
+import diskCacheV111.pools.PoolCostInfo;
+import diskCacheV111.services.space.Space;
+import diskCacheV111.services.space.SpaceState;
+import diskCacheV111.util.AccessLatency;
+import diskCacheV111.util.CacheException;
+import diskCacheV111.util.RetentionPolicy;
+import java.util.List;
+import java.util.Optional;
+import org.dcache.poolmanager.PoolMonitor;
+import org.junit.Test;
+
+public class CapacityTest {
+
+    private final PoolMonitor poolMonitor = mock(PoolMonitor.class);
+    private Optional<Space> space = Optional.of(space(42, 1000, 300, 200));
+
+    @Test
+    public void shouldReportFixedSizeForNamespace() throws Exception {
+        Capacity capacity = provider("namespace", "").get(null);
+
+        assertThat(capacity.getTotalSpace(), is(1L << 60));
+        assertThat(capacity.getUsedSpace(), is(0L));
+    }
+
+    @Test
+    public void shouldSumSpaceOfAllPools() throws Exception {
+        givenPools(pool("pool1", 1000, 100, 50), pool("pool2", 2000, 300, 0));
+
+        Capacity capacity = provider("pools", "").get(null);
+
+        assertThat(capacity.getTotalSpace(), is(3000L));
+        assertThat(capacity.getFreeSpace(), is(450L));
+    }
+
+    @Test
+    public void shouldFailWithoutPools() {
+        givenPools();
+
+        CacheException e = assertThrows(CacheException.class,
+              () -> provider("pools", "").get(null));
+        assertThat(e.getRc(), is(CacheException.SERVICE_UNAVAILABLE));
+    }
+
+    @Test
+    public void shouldReportConfiguredReservation() throws Exception {
+        Capacity.Provider provider = provider("reservation", "42");
+
+        Capacity capacity = provider.get("7");
+
+        assertThat(provider.usesWriteToken(), is(false));
+        assertThat(capacity.getTotalSpace(), is(1000L));
+        assertThat(capacity.getFreeSpace(), is(500L));
+        assertThat(capacity.getReservation(), is(Optional.of("42")));
+    }
+
+    @Test
+    public void shouldReportReservationOfWriteToken() throws Exception {
+        Capacity.Provider provider = provider("reservation", "");
+
+        assertThat(provider.usesWriteToken(), is(true));
+        assertThat(provider.get("42").getReservation(), is(Optional.of("42")));
+    }
+
+    @Test
+    public void shouldFailWithoutWriteToken() {
+        CacheException e = assertThrows(CacheException.class,
+              () -> provider("reservation", "").get(null));
+        assertThat(e.getRc(), is(CacheException.INVALID_ARGS));
+    }
+
+    @Test
+    public void shouldRecoverWhenReservationReappears() throws Exception {
+        Capacity.Provider provider = provider("reservation", "42");
+        space = Optional.empty();
+        assertThrows(CacheException.class, () -> provider.get(null));
+        assertThrows(CacheException.class, () -> provider.get(null));
+
+        space = Optional.of(space(42, 100, 80, 50));
+
+        assertThat(provider.get(null).getFreeSpace(), is(0L));
+    }
+
+    @Test
+    public void shouldRejectInvalidConfiguration() {
+        assertThrows(IllegalArgumentException.class, () -> provider("1234", ""));
+        assertThrows(IllegalArgumentException.class, () -> provider("reservation", "CMS_DISK"));
+    }
+
+    private Capacity.Provider provider(String source, String reservation) {
+        // Not cached, so that tests can change the space reservation.
+        return new Capacity.Provider(source, reservation, poolMonitor,
+              CacheBuilder.newBuilder().maximumSize(0).build(CacheLoader.from(token -> space)));
+    }
+
+    private void givenPools(PoolCostInfo... pools) {
+        CostModule costModule = mock(CostModule.class);
+        when(costModule.getPoolCostInfos()).thenReturn(List.of(pools));
+        when(poolMonitor.getCostModule()).thenReturn(costModule);
+    }
+
+    private static PoolCostInfo pool(String name, long total, long free, long removable) {
+        PoolCostInfo info = new PoolCostInfo(name, "regular");
+        info.setSpaceUsage(total, free, 0, removable);
+        return info;
+    }
+
+    static Space space(long id, long size, long used, long allocated) {
+        return new Space(id, null, null, RetentionPolicy.REPLICA, AccessLatency.ONLINE, 1, size,
+              0, null, "test", SpaceState.RESERVED, used, allocated);
+    }
+}
