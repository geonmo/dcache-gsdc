+# Source of the file system size and free space reported to clients
+# (e.g., by df). See dcache.capacity.source for the possible values.
+#
+# With 'namespace' (the default), the door reports a fixed size of 1 EiB
+# and the space used by all files in the namespace.
+#
+# With 'reservation', nfs.capacity.reservation must be set, as NFS clients
+# don't tell the door which export a statfs request is for; the door fails
+# to start otherwise. Consequently, a single space reservation is reported
+# for all exports of the door.
+#
+# File counts are always taken from the namespace. If the pools or the
+# space reservation can't be looked up, the door falls back to the
+# namespace statistics. The reported values are cached for
+# nfs.fs-stat-cache.time.
+(one-of?namespace|pools|reservation|${dcache.capacity.source})nfs.capacity.source = ${dcache.capacity.source}
+
+# Space token of the reservation reported if nfs.capacity.source is
+# 'reservation'.
+nfs.capacity.reservation = ${dcache.capacity.reservation}
