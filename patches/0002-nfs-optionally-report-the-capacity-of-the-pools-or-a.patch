+public class DCacheAwareJdbcFsTest {
+
+    private static final URL DB_TEST_PROPERTIES =
+          Resources.getResource("org/dcache/chimera/chimera-test.properties");
+
+    private HikariDataSource dataSource;
+    private DCacheAwareJdbcFs fs;
+    private FsStat namespaceStat;
+
+    @Before
+    public void setUp() throws Exception {
+        Properties dbProperties = new Properties();
+        try (InputStream input = Resources.asByteSource(DB_TEST_PROPERTIES).openStream()) {
+            dbProperties.load(input);
+        }
+
+        dataSource = FsFactory.getDataSource(
+              dbProperties.getProperty("chimera.db.url"),
+              dbProperties.getProperty("chimera.db.user"),
+              dbProperties.getProperty("chimera.db.password"));
+
+        try (Connection conn = dataSource.getConnection()) {
+            Database database = DatabaseFactory.getInstance()
+                  .findCorrectDatabaseImplementation(new JdbcConnection(conn));
+            Liquibase liquibase = new Liquibase("org/dcache/chimera/changelog/changelog-master.xml",
+                  new ClassLoaderResourceAccessor(), database);
+            liquibase.update("");
+        }
+
+        fs = new DCacheAwareJdbcFs(dataSource, new DataSourceTransactionManager(dataSource),
+              "strong");
+        namespaceStat = fs.getFsStat();
+    }
+
+    @After
+    public void tearDown() throws Exception {
+        try (Connection conn = dataSource.getConnection()) {
+            conn.createStatement().execute("SHUTDOWN;");
+        }
+        dataSource.close();
+        fs.close();
+    }
+
+    @Test
+    public void shouldReportNamespaceStatisticsByDefault() throws Exception {
+        assertEquals(JdbcFs.AVAILABLE_SPACE, fs.getFsStat().getTotalSpace());
+    }
+
+    @Test
+    public void shouldReportNamespaceStatisticsForNamespaceSource() throws Exception {
+        fs.setCapacitySource("namespace");
+        fs.setCapacityReservation("42");
+        fs.checkCapacityConfiguration();
+
+        assertEquals(JdbcFs.AVAILABLE_SPACE, fs.getFsStat().getTotalSpace());
+    }
+
+    @Test
+    public void shouldReportSpaceOfAllPools() throws Exception {
+        givenPools(pool("pool1", 1000, 100, 50), pool("pool2", 2000, 300, 0));
+        fs.setCapacitySource("pools");
+        fs.checkCapacityConfiguration();
+
+        FsStat stat = fs.getFsStat();
+
+        assertEquals(3000, stat.getTotalSpace());
+        assertEquals(2550, stat.getUsedSpace());
+        assertEquals(namespaceStat.getTotalFiles(), stat.getTotalFiles());
+        assertEquals(namespaceStat.getUsedFiles(), stat.getUsedFiles());
+    }
+
+    @Test
+    public void shouldFallBackIfPoolInformationIsNotAvailable() throws Exception {
+        givenPools();
+        fs.setCapacitySource("pools");
+
+        assertEquals(JdbcFs.AVAILABLE_SPACE, fs.getFsStat().getTotalSpace());
+    }
+
+    @Test
+    public void shouldReportSpaceReservationSizeAndUsage() throws Exception {
+        givenSpaceLookup(token -> token.equals("42")
+              ? Optional.of(space(1000, 300, 200)) : Optional.empty());
+        fs.setCapacitySource("reservation");
+        fs.setCapacityReservation("42");
+        fs.checkCapacityConfiguration();
+
+        FsStat stat = fs.getFsStat();
+
+        assertEquals(1000, stat.getTotalSpace());
+        assertEquals(500, stat.getUsedSpace());
+        assertEquals(namespaceStat.getTotalFiles(), stat.getTotalFiles());
+        assertEquals(namespaceStat.getUsedFiles(), stat.getUsedFiles());
+    }
