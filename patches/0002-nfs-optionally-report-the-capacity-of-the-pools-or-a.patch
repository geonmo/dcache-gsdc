+    public void setCapacitySource(String source) {
+        capacitySource = Capacity.Source.fromProperty(source);
+    }
+
+    public void setCapacityReservation(String reservation) {
+        capacityReservation = Capacity.parseReservation(reservation);
+    }
+
+    public void setSpaceLookupCache(LoadingCache<String, Optional<Space>> spaceLookupCache) {
+        this.spaceLookupCache = spaceLookupCache;
+    }
+
+    /**
+     * Checks that the capacity configuration is complete. As NFS doesn't tell the file system
+     * which export a statfs request is for, a space reservation can't be found through the
+     * WriteToken tag and must be configured explicitly.
+     */
+    public void checkCapacityConfiguration() {
+        if (capacitySource == Capacity.Source.RESERVATION && capacityReservation.isEmpty()) {
+            throw new IllegalArgumentException("nfs.capacity.source=reservation requires"
+                  + " nfs.capacity.reservation to be set, as the NFS door can't use the"
+                  + " WriteToken tag of a path.");
+        }
+    }
+
     @Override
     public void setCellAddress(CellAddressCore address) {
         myAddress = address;
     }
 
+    /**
+     * Reports the total and used space of the configured capacity source. File counts are always
+     * taken from the namespace. Falls back to namespace statistics if the capacity can't be
+     * determined.
+     */
+    @Override
+    public FsStat getFsStat() throws ChimeraFsException {
+        FsStat fsStat = super.getFsStat();
+        if (capacitySource == Capacity.Source.NAMESPACE) {
+            return fsStat;
+        }
+
+        try {
+            Capacity capacity = getCapacity();
+            return new FsStat(capacity.getTotalSpace(), fsStat.getTotalFiles(),
+                  capacity.getUsedSpace(), fsStat.getUsedFiles());
+        } catch (CacheException e) {
+            LOGGER.warn("{}; reporting namespace statistics.", e.getMessage());
+        } catch (ExecutionException | UncheckedExecutionException e) {
+            LOGGER.warn("Failed to look up space reservation {}: {}; reporting namespace"
+                  + " statistics.", capacityReservation.orElse(""), e.getCause().getMessage());
+        }
+        return fsStat;
+    }
+
+    private Capacity getCapacity() throws CacheException, ExecutionException {
+        switch (capacitySource) {
+            case POOLS:
+                return Capacity.ofPools(poolMonitor).orElseThrow(
+                      () -> new CacheException("Pool information is not available"));
+            case RESERVATION:
+                String token = capacityReservation.orElseThrow();
+                return spaceLookupCache.get(token).map(Capacity::of).orElseThrow(
+                      () -> new CacheException("Space reservation " + token + " not found"));
+            default:
+                throw new IllegalStateException("Unexpected capacity source: " + capacitySource);
+        }
+    }
+
