+
+        FsStat stat = fs.getFsStat();
+
+        assertEquals(100, stat.getTotalSpace());
+        assertEquals(100, stat.getUsedSpace());
+    }
+
+    @Test
+    public void shouldFallBackIfSpaceReservationNotFound() throws Exception {
+        givenSpaceLookup(token -> Optional.empty());
+        fs.setCapacitySource("reservation");
+        fs.setCapacityReservation("42");
+
+        assertEquals(JdbcFs.AVAILABLE_SPACE, fs.getFsStat().getTotalSpace());
