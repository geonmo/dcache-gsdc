+        when(costModule.getPoolCostInfos()).thenReturn(Arrays.asList(pools));
+        RemotePoolMonitor poolMonitor = mock(RemotePoolMonitor.class);
+        when(poolMonitor.getCostModule()).thenReturn(costModule);
+        fs.setPoolMonitor(poolMonitor);
+    }
